---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = site.pages | where_exp: "p", "p.sitemap != false" %}
{%- for p in pages %}{% if p.url contains '.xml' or p.url contains '.css' or p.url contains '.js' %}{% continue %}{% endif %}
  <url><loc>{{ p.url | replace: 'index.html', '' | absolute_url }}</loc><lastmod>{{ site.time | date: '%Y-%m-%d' }}</lastmod></url>
{%- endfor %}
{%- for p in site.sectors %}
  <url><loc>{{ p.url | absolute_url }}</loc><lastmod>{{ site.time | date: '%Y-%m-%d' }}</lastmod></url>
{%- endfor %}
{%- for p in site.prints %}
  <url><loc>{{ p.url | absolute_url }}</loc><lastmod>{{ site.time | date: '%Y-%m-%d' }}</lastmod></url>
{%- endfor %}
{%- for p in site.posts %}
  <url><loc>{{ p.url | absolute_url }}</loc><lastmod>{{ p.date | date: '%Y-%m-%d' }}</lastmod></url>
{%- endfor %}
</urlset>
